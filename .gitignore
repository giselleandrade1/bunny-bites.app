# Portfolio Showcase Mode
# Goal: keep only root sample files versioned for public GitHub presentation.
# Tracked files that are already in git must be untracked with:
# git rm -r --cached . && git add .

# Ignore everything by default
/*

# Allow only public showcase files at repository root
!/.gitignore
!/README.md
!/index.html
!/style.css
!/script.js
!/*.html
!/auth-config.js
!/BACKEND_AUTH_CONTRACT.md
!/test-cart-wishlist.sh

# Allow backend source when deploying fullstack flows
!/backend/
!/backend/**

# Allow deploy-critical static assets
!/assets/
!/assets/data/
!/assets/data/products.json
!/assets/images/
!/assets/images/**

# Common local and generated noise (kept for clarity/documentation)
node_modules/
**/node_modules/
dist/
build/
out/
coverage/
.cache/
.parcel-cache/
.next/
.nuxt/
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environments and secrets
.env
.env.*
!.env.example

# Databases and local storage
*.db
*.sqlite
*.sqlite3

# Editor/IDE
.vscode/
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Design scraps and drafts
*.psd
*.ai
*.sketch
*.fig
*draft*
*backup*

# Internal folders if used in future
private/
internal/
