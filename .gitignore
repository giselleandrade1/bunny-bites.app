# Bunny Bites fullstack deployment mode
# Keep project files tracked, while ignoring local/runtime noise.

# Dependencies and package managers
node_modules/
**/node_modules/
.pnpm-store/
.npm/
.yarn/

# Build, cache, coverage, and generated output
dist/
build/
out/
coverage/
.cache/
.parcel-cache/
.next/
.nuxt/
.turbo/
.vite/

# Temp and backup files
tmp/
temp/
*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and local config
.env
.env.*
!.env.example
backend/.env

# Databases and local state
*.db
*.sqlite
*.sqlite3
backend/data/
!backend/data/.gitkeep

# IDE/editor files
.vscode/
.idea/
*.iml

# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini

# Design scraps and drafts
*.psd
*.ai
*.sketch
*.fig
*draft*
*backup*
*copy*

# Non-essential docs and internal material (if kept locally)
docs-internal/
private/
internal/
