# Portfolio Showcase Strategy
# Intent: keep the public repository focused on a small root-level sample.
# Note: .gitignore does not hide files already tracked by Git.

# Ignore everything by default.
/*

# Allow only showcase essentials at repository root.
!/.gitignore
!/README.md
!/index.html
!/style.css
!/script.js

# Dependencies and package managers
node_modules/
**/node_modules/
.pnpm-store/
.npm/
.yarn/

# Build, cache, coverage, and generated output
dist/
build/
out/
coverage/
.cache/
.parcel-cache/
.next/
.nuxt/
.turbo/
.vite/

# Temp and backup files
tmp/
temp/
*.tmp
*.temp
*.bak
*.old
*.orig
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and local config
.env
.env.*
!.env.example

# Databases and local state
*.db
*.sqlite
*.sqlite3

# IDE/editor files
.vscode/
.idea/
*.iml

# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini

# Design scraps and drafts
*.psd
*.ai
*.sketch
*.fig
*draft*
*backup*
*copy*

# Non-essential docs and internal material (if kept locally)
docs-internal/
private/
internal/
